{
    "name": "lotse/openmage-connector",
    "description": "Lotse Connector: token-gesicherte JSON-API für OpenMage (Magento 1), gelesen und geschrieben von Lotse",
    "type": "magento-module",
    "license": "MIT",
    "version": "1.2.0",
    "require": {
        "php": ">=7.4",
        "magento-hackathon/magento-composer-installer": "*"
    },
    "extra": {
        "map": [
            ["app/code/community/Lotse/Connector", "app/code/community/Lotse/Connector"],
            ["app/etc/modules/Lotse_Connector.xml", "app/etc/modules/Lotse_Connector.xml"],
            ["shell/lotse.php", "shell/lotse.php"]
        ]
    }
}
