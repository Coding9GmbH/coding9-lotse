<?xml version="1.0"?>
<!--
  Lotse Connector: module configuration.
  The custom router (Lotse_Connector_Controller_Router) intercepts /lotse-api/... and
  dispatches Lotse_Connector_ApiController. Deliberately no standard router entry, so
  controller and action names cannot be guessed from the path.
-->
<config>
    <modules>
        <Lotse_Connector>
            <version>1.3.0</version>
        </Lotse_Connector>
    </modules>
    <global>
        <helpers>
            <lotse_connector>
                <class>Lotse_Connector_Helper</class>
            </lotse_connector>
        </helpers>
        <models>
            <lotse_connector>
                <class>Lotse_Connector_Model</class>
            </lotse_connector>
        </models>
        <blocks>
            <lotse_connector>
                <class>Lotse_Connector_Block</class>
            </lotse_connector>
        </blocks>
        <!-- Router registration like Mage_Cms: global, so it applies in every area -->
        <events>
            <controller_front_init_routers>
                <observers>
                    <lotse_connector>
                        <class>Lotse_Connector_Controller_Router</class>
                        <method>initControllerRouters</method>
                    </lotse_connector>
                </observers>
            </controller_front_init_routers>
        </events>
    </global>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <lotse_connector before="Mage_Adminhtml">Lotse_Connector_Adminhtml</lotse_connector>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <default>
        <lotse>
            <api>
                <enabled>0</enabled>
                <token/>
                <ip_allowlist/>
                <trust_proxy>0</trust_proxy>
            </api>
        </lotse>
    </default>
</config>
