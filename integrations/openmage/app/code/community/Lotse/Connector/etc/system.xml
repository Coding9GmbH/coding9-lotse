<?xml version="1.0"?>
<!-- Lotse Connector: Admin-Konfiguration (System > Konfiguration > Lotse > API). -->
<config>
    <tabs>
        <lotse translate="label" module="lotse_connector">
            <label>Lotse</label>
            <sort_order>400</sort_order>
        </lotse>
    </tabs>
    <sections>
        <lotse translate="label" module="lotse_connector">
            <label>API</label>
            <tab>lotse</tab>
            <frontend_type>text</frontend_type>
            <sort_order>10</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <api translate="label comment" module="lotse_connector">
                    <label>Lotse-Schnittstelle</label>
                    <comment>Token-gesicherte JSON-API unter /lotse-api/v1/. Der Token wird verschlüsselt gespeichert und nur einmal angezeigt.</comment>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label" module="lotse_connector">
                            <label>Aktiv</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                        <token translate="label comment" module="lotse_connector">
                            <label>API-Token</label>
                            <frontend_type>button</frontend_type>
                            <frontend_model>lotse_connector/adminhtml_config_token</frontend_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>„Token erzeugen“ ersetzt einen vorhandenen Token sofort. Alternativ per Shell: php shell/lotse.php --generate-token</comment>
                        </token>
                        <ip_allowlist translate="label comment" module="lotse_connector">
                            <label>IP-Freigabeliste</label>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Optional. Eine IP oder ein CIDR-Netz je Zeile (IPv4/IPv6), z. B. 203.0.113.10 oder 10.0.0.0/8. Leer = alle Adressen.</comment>
                        </ip_allowlist>
                        <trust_proxy translate="label comment" module="lotse_connector">
                            <label>Client-IP aus X-Forwarded-For lesen</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Nur aktivieren, wenn ein vertrauenswürdiger Reverse-Proxy vor dem Shop steht und den Header setzt. Gezählt wird der letzte Eintrag (vom Proxy angehängt); die vorderen kann der Client fälschen.</comment>
                        </trust_proxy>
                    </fields>
                </api>
            </groups>
        </lotse>
    </sections>
</config>
