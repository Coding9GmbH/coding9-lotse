# Lotse configuration (copy to .env). Everything can also be set later in the UI under "Einstellungen" (settings);
# credentials entered there are stored encrypted in the volume and take precedence.

# ---- AI ----
# Provider: claude (default) or codex (ChatGPT subscription; then sign in via the UI: "Mit ChatGPT anmelden")
AI_PROVIDER=
# Optional Codex model (empty = your subscription's default)
CODEX_MODEL=

# Claude: Anthropic API key (usage-based, console.anthropic.com). A Claude subscription is not supported.
ANTHROPIC_API_KEY=
# Model (optional), e.g. sonnet or opus
AI_MODEL=
# Cost brake: monthly budget for Claude in US dollars (e.g. 50). Empty = no limit. A value in the settings takes precedence.
LOTSE_AI_BUDGET_USD=

# ---- Shop platform ----
# Exactly one shop is connected: shopware (default), shopify, magento (Magento 2) or openmage (Magento 1 with the Lotse_Connector module)
SHOP_PLATFORM=

# ---- Shopware 6 ----
# Recommended: a dedicated integration (Admin → Einstellungen → System → Integrationen) with a restricted role
SHOPWARE_URL=
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
# Alternatively an admin user (test/demo shops only)
SHOPWARE_USER=
SHOPWARE_PASSWORD=
# If the browser reaches the shop at a different address than the container does (e.g. demo shop)
SHOPWARE_PUBLIC_URL=

# ---- Shopify: app from the Dev Dashboard (client ID + client secret, Lotse fetches the token itself)
# ---- or Admin API access token of an existing custom app from "Apps entwickeln" (develop apps) ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_PUBLIC_URL=
SHOPIFY_API_VERSION=

# ---- Magento 2 / Adobe Commerce (integration token or admin user) ----
MAGENTO_URL=
MAGENTO_ACCESS_TOKEN=
MAGENTO_USER=
MAGENTO_PASSWORD=
MAGENTO_PUBLIC_URL=
MAGENTO_STORE_CODE=
# Prices in the Magento admin: gross (incl. VAT) or net (excl. VAT, Magento default). Empty = Lotse does not change prices.
MAGENTO_PRICE_BASIS=

# ---- OpenMage / Magento 1 (requires the Lotse_Connector module from integrations/openmage/) ----
OPENMAGE_URL=
# The module's API token (Admin → System → Konfiguration → Lotse → API → "Token erzeugen")
OPENMAGE_TOKEN=
# If the browser reaches the shop at a different address than the container does
OPENMAGE_PUBLIC_URL=
# Code of the store view whose texts Lotse reads and writes (empty = default store view)
OPENMAGE_STORE_CODE=

# ---- Optional ----
# Image AI (OpenAI) for generated images
OPENAI_API_KEY=
IMAGE_MODEL=
# Access protection: if set, Lotse asks for this password via browser login (any username, e.g. lotse).
# Mandatory as soon as Lotse runs on anything other than 127.0.0.1 (e.g. on a server behind a reverse proxy).
# Choose something random and long: openssl rand -base64 32. Guide: docs/self-hosting.md
LOTSE_PASSWORD=
# Retention in days: access log (default 180) and change log (default 365, at least 30); 0 = never delete
LOTSE_LOG_RETENTION_DAYS=
LOTSE_AUDIT_RETENTION_DAYS=
# Additional allowed hostnames (comma-separated, without scheme and port), e.g. lotse.example.com
ALLOWED_HOSTS=
# Reverse proxy on another machine/ingress (IPs or IPv4 CIDR, comma-separated): its X-Forwarded-For counts for login throttling
LOTSE_TRUSTED_PROXIES=
# Published address (127.0.0.1, localhost or ::1). Compose sets 127.0.0.1; otherwise Lotse warns inside the container.
LOTSE_BIND=127.0.0.1
# Port on your machine
LOTSE_PORT=3333
# Maximum concurrent writes to the shop (spares small servers)
LOTSE_WRITE_CONCURRENCY=2
# Timeout per shop request in milliseconds (default 60000, at least 5000)
LOTSE_SHOP_TIMEOUT_MS=
# Maximum concurrent read/write requests to Magento 2 or OpenMage (default 4, at most 8)
LOTSE_MAGENTO_CONCURRENCY=
LOTSE_OPENMAGE_CONCURRENCY=
# Address at which Lotse reaches itself (for the Codex tools; default http://127.0.0.1:<PORT>)
LOTSE_INTERNAL_URL=
# Tests only: redirect the Search Console API and token endpoint to a custom server (empty = Google)
LOTSE_GSC_API_BASE=
LOTSE_GSC_TOKEN_URL=
# Tests only: redirect the Sistrix API to a custom server (empty = https://api.sistrix.com)
LOTSE_SISTRIX_API_BASE=
# Shopware: clear the shop cache after apply/undo (on by default). 0 = off
LOTSE_CLEAR_CACHE=
# Tests only: redirect the image API (OpenAI) to a custom server (empty = https://api.openai.com/v1)
LOTSE_OPENAI_API_BASE=
# Server log: json = one JSON line per entry (ts, level, msg, chatId, …), empty = human-readable. Secrets are redacted.
LOTSE_LOG_FORMAT=
# Minimum level: debug | info (default) | warn | error | silent
LOTSE_LOG_LEVEL=
