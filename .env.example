# Lotse – Konfiguration (kopieren nach .env). Alles kann auch später in der Oberfläche unter „Einstellungen“ gesetzt werden;
# dort eingegebene Zugangsdaten werden verschlüsselt im Volume gespeichert und haben Vorrang.

# ---- KI ----
# Anbieter: claude (Standard) oder codex (ChatGPT-Abo – Anmeldung danach in der Oberfläche: „Mit ChatGPT anmelden“)
AI_PROVIDER=
# Optionales Codex-Modell (leer = Standard deines Abos)
CODEX_MODEL=

# Claude: Anthropic-API-Schlüssel (nutzungsbasiert, console.anthropic.com). Ein Claude-Abo wird nicht unterstützt.
ANTHROPIC_API_KEY=
# Modell (optional), z. B. sonnet oder opus
AI_MODEL=

# ---- Shop-Plattform ----
# Genau ein Shop ist verbunden: shopware (Standard), shopify, magento (Magento 2) oder openmage (Magento 1 mit dem Modul Lotse_Connector)
SHOP_PLATFORM=

# ---- Shopware 6 ----
# Empfohlen: eigene Integration (Admin → Einstellungen → System → Integrationen) mit eingeschränkter Rolle
SHOPWARE_URL=
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
# Alternativ Admin-Benutzer (nur für Test-/Demo-Shops)
SHOPWARE_USER=
SHOPWARE_PASSWORD=
# Falls der Browser den Shop unter einer anderen Adresse erreicht als der Container (z. B. Demo-Shop)
SHOPWARE_PUBLIC_URL=

# ---- Shopify: App aus dem Dev Dashboard (Client-ID + Client-Secret, Token holt Lotse selbst)
# ---- oder Admin-API-Zugriffstoken einer bestehenden eigenen App aus „Apps entwickeln“ ----
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_PUBLIC_URL=
SHOPIFY_API_VERSION=

# ---- Magento 2 / Adobe Commerce (Integrations-Token oder Admin-Benutzer) ----
MAGENTO_URL=
MAGENTO_ACCESS_TOKEN=
MAGENTO_USER=
MAGENTO_PASSWORD=
MAGENTO_PUBLIC_URL=
MAGENTO_STORE_CODE=
# Preise im Magento-Admin: gross (inkl. MwSt.) oder net (exkl. MwSt., Magento-Standard). Leer = Lotse ändert keine Preise.
MAGENTO_PRICE_BASIS=

# ---- OpenMage / Magento 1 (braucht das Modul Lotse_Connector aus integrations/openmage/) ----
OPENMAGE_URL=
# API-Token des Moduls (Admin → System → Konfiguration → Lotse → API → „Token erzeugen“)
OPENMAGE_TOKEN=
# Falls der Browser den Shop unter einer anderen Adresse erreicht als der Container
OPENMAGE_PUBLIC_URL=
# Code der Store-View, deren Texte Lotse liest und schreibt (leer = Standard-Store-View)
OPENMAGE_STORE_CODE=

# ---- Optional ----
# Bild-KI (OpenAI) für generierte Bilder
OPENAI_API_KEY=
IMAGE_MODEL=
# Zugangsschutz: Wenn gesetzt, fragt Lotse per Browser-Login nach diesem Passwort (Benutzername beliebig, z. B. lotse).
# Pflicht, sobald Lotse nicht nur auf 127.0.0.1 läuft (z. B. auf einem Server hinter Reverse-Proxy).
# Zufällig und lang wählen: openssl rand -base64 32. Anleitung: docs/self-hosting.md
LOTSE_PASSWORD=
# Zusätzliche erlaubte Hostnamen (kommagetrennt, ohne Schema und Port), z. B. lotse.example.com
ALLOWED_HOSTS=
# Veröffentlichte Adresse (127.0.0.1, localhost oder ::1). Compose setzt 127.0.0.1; im Container warnt Lotse sonst.
LOTSE_BIND=127.0.0.1
# Port auf deinem Rechner
LOTSE_PORT=3333
# Maximal parallele Schreibzugriffe auf den Shop (schont kleine Server)
LOTSE_WRITE_CONCURRENCY=2
# Timeout je Shop-Anfrage in Millisekunden (Standard 60000, mindestens 5000)
LOTSE_SHOP_TIMEOUT_MS=
# Maximal parallele Lese-/Schreibanfragen an Magento 2 bzw. OpenMage (Standard 4, höchstens 8)
LOTSE_MAGENTO_CONCURRENCY=
LOTSE_OPENMAGE_CONCURRENCY=
# Adresse, unter der Lotse sich selbst erreicht (für die Codex-Werkzeuge; Standard http://127.0.0.1:<PORT>)
LOTSE_INTERNAL_URL=
# Nur für Tests: Search-Console-API und Token-Endpunkt auf einen eigenen Server umbiegen (leer = Google)
LOTSE_GSC_API_BASE=
LOTSE_GSC_TOKEN_URL=
# Nur für Tests: Bild-API (OpenAI) auf einen eigenen Server umbiegen (leer = https://api.openai.com/v1)
LOTSE_OPENAI_API_BASE=
